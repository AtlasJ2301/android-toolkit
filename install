#!/bin/bash

printf "" > ./libs/SCRCPY/null

if [[ "$1" = "--help" ]]; then
    printf "\nUsed to install android-toolkit to the system.\n\nAndroid Toolkit: An easy to use ADB interface\n\nUsage:\n\n-d       Compile as developer\n-r       Uninstall android-toolkit from device\n-s       Creates shortcut to implement SCRCPY\n-u       Update android-toolkit from github.\n"
    exit
fi

if [[ "$1" = "-r" || "$2" = "-r" ]]; then

    rm -r ~/.android-toolkit/
    rm ~/.local/share/applications/android-toolkit.desktop
    sudo rm /usr/bin/android-toolkit

else if [[ "$1" = "-u" ]]; then

    git pull origin

    read -p "Press ENTER to continue." null

fi

    if [[ "$1" = "-s" || "$2" = "-s" ]]; then
        if [[ "$1" = "-d" || "$2" = "-d" ]]; then
            cp ../SCRCPY/* ./libs/SCRCPY/
        else
            printf "Creating link...\n"
            rm -r ./SCRCPY
            ln -s ./libs/SCRCPY/ ./

            read -p "Please drag and drop the contents of your SCRCPY download to the link made in the projects folder" null
        fi
    fi

    if [[ "$1" = "-d" || "$2" = "-d" ]]; then
        printf "DEBUG MODE\n\n"
    fi

    if [[ -d ./build ]]; then
        rm -r ./build
    fi

    if [[ -d "/home/$USER/.android-toolkit/" ]]; then
        rm -r ~/.android-toolkit/
    fi

    mkdir ~/.android-toolkit/
    mkdir ./build
    cd ./build

    cmake ../
    make

    cd ..

    cp ./README.md ~/.android-toolkit/README.md
    cp -r ./libs/ ~/.android-toolkit/libs/
    cp ./icon.png ~/.android-toolkit/icon.png
    cp ./build/android-toolkit ~/.android-toolkit/android-toolkit

    printf "[Desktop Entry]\nName=Android Toolkit\nExec=gnome-terminal --geometry=115x40 -- /home/$USER/.android-toolkit/android-toolkit\nType=Application\nIcon=/home/$USER/.android-toolkit/icon.png\nComment=An Easy to use ADB interface" > "/home/$USER/.android-toolkit/android-toolkit.desktop"
    sudo cp -f ./libs/android-toolkit /usr/bin/android-toolkit
    sudo chmod +x /usr/bin/android-toolkit
    cp ~/.android-toolkit/android-toolkit.desktop ~/.local/share/applications

    if [[ "$1" = "-d" || "$2" = "-d" ]]; then

        touch ~/.android-toolkit/isDebug

    fi

    rm -r ./build
    if [[ "$1" = "-s" || "$2" = "-s" ]]; then
        rm -r SCRCPY
    fi
    if [[ "$1" = "-d" || "$2" = "-d" ]]; then
        rm ./libs/SCRCPY/*
        printf "" > ./libs/SCRCPY/null
    fi
    read -p "Press ENTER to continue." null
   

    gnome-terminal --geometry=115x40 -- ~/.android-toolkit/android-toolkit

fi