#!/bin/bash

printf "" > tmp

if [[ $1 = --debug-installer ]]; then
    while [ 1 = 1 ]; do
        read -p "Input Bash Command\n\n> " input
        if [[ "$input" = "exit" ]]; then
            break
        fi
        $input
    done
    exit
fi

echo "$1" >> tmp
printf "\n" >> tmp
echo "$2" >> tmp
printf "\n" >> tmp
echo "$3" >> tmp

g++ ./src/install.cpp -o ./install.out

if [[ "$1" = "wait" ]]; then
    read null
fi
./install.out
exit