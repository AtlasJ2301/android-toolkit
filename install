#!/bin/bash

clear

prompt() {
    printf "Running this file will add / upgrade the following commands to your linux system:\n- android-toolkit\n\nNote: For SCRCPY compatability, please download the files from https://github.com/Genymobile/scrcpy and paste the contents (Not the folder) of the archive into the SCRCPY folder in the index directory before installing.\n\n" 
    read -p "Continue? (y) > " ans
    clear
    printf "Would you like to install GUI (1) or Terminal Based (2) android-toolkit?"
    read -p "( 1 / 2 ) > " gui
}

if [[ -d /home/$USER/.android-toolkit ]]; then
    echo "Would you like to upgrade (1) or delete (2) android-toolkit?"
    read -p "> " ans0
    if [ $ans0 = '1' ]; then
        clear
        prompt
    fi

    if [ $ans0 = '2' ]; then
    clear
        rm -r /home/$USER/.android-toolkit/
        xterm -e "pkexec rm /usr/bin/android-toolkit"
    fi
else
    prompt
fi

if [[ "${ans}" = 'y' ]]; then
   clear
    mv ./usr/src/debug.sh ./usr/ect/
    mv ./usr/src/debugGUI.sh ./usr/ect/
    
    if [ -d /home/$USER/.android-toolkit ]; then
        rm -r /home/$USER/.android-toolkit/
    fi
    
    mkdir /home/$USER/.android-toolkit/
    
    cp -r ./usr/ /home/$USER/.android-toolkit/usr/

    if [[ "${gui}" = '2' ]]; then
        
        index="./index.sh"
        
        printf "0" > /home/$USER/.android-toolkit/usr/var/gui

    else

        index="./indexGUI.sh"
        
        printf "1" > /home/$USER/.android-toolkit/usr/var/gui
    
    fi

    for dirFrom in "${index}" "./icon.png" "./README.md"; do cp $dirFrom /home/$USER/.android-toolkit/; done;
    
    sudo cp ./usr/bin/android-toolkit /usr/bin/android-toolkit && sudo chmod +x /usr/bin/android-toolkit
    for chmodPath in "/home/$USER/.android-toolkit/index.sh" "/home/$USER/.android-toolkit/usr/src/android-toolkit/*.sh" "/home/$USER/.android-toolkit/usr/src/android-toolkit/uninstall"; do chmod +x $chmodPath; done;

    mv ./usr/ect/debug.sh ./usr/src/
    mv ./usr/ect/debugGUI.sh ./usr/src/

    echo "Install Complete!"

    sleep 1

    outro

    clear
fi
exit